diff --git a/include/rex/graphics/vulkan/descriptor_snapshot.h b/include/rex/graphics/vulkan/descriptor_snapshot.h
new file mode 100644
index 0000000..9edbe3f
--- /dev/null
+++ b/include/rex/graphics/vulkan/descriptor_snapshot.h
@@ -0,0 +1,60 @@
+#pragma once
+#include <vulkan/vulkan.h>
+#include <span>
+#include <array>
+#include <vector>
+namespace rex::graphics::vulkan {
+// Only retains CPU descriptions; ownership stays with the descriptor allocator.
+class TextureDescriptorSnapshot {
+ public:
+  void Invalidate() { valid_ = false; }
+  bool MatchesShape(VkDescriptorSetLayout layout, size_t texture_count, size_t sampler_count) const {
+    return valid_ && layout_ == layout && texture_count_ == texture_count &&
+           images_.size() == texture_count + sampler_count;
+  }
+  bool MatchesSampler(size_t index, VkSampler sampler) const {
+    return valid_ && index < images_.size() - texture_count_ &&
+           images_[texture_count_ + index].sampler == sampler;
+  }
+  bool MatchAndRemember(VkDescriptorSetLayout layout, size_t texture_count,
+                        std::span<const VkDescriptorImageInfo> images) {
+    bool same = valid_ && layout_ == layout && texture_count_ == texture_count && images_.size() == images.size();
+    if (same) {
+      for (size_t i = 0; i < images.size(); ++i) {
+        if (images_[i].sampler != images[i].sampler || images_[i].imageView != images[i].imageView ||
+            images_[i].imageLayout != images[i].imageLayout) { same = false; break; }
+      }
+    }
+    if (!same) {
+      layout_ = layout; texture_count_ = texture_count;
+      images_.assign(images.begin(), images.end()); valid_ = true;
+    }
+    return same;
+  }
+ private:
+  bool valid_ = false;
+  VkDescriptorSetLayout layout_ = VK_NULL_HANDLE;
+  size_t texture_count_ = 0;
+  std::vector<VkDescriptorImageInfo> images_;
+};
+// Dynamic offsets are supplied at bind time. Descriptor identity depends only
+// on the underlying buffers and ranges; the layout is fixed for guest constants.
+template <size_t Count>
+class DynamicUniformDescriptorSnapshot {
+ public:
+  void Invalidate() { valid_ = false; }
+  bool MatchAndRemember(std::span<const VkDescriptorBufferInfo, Count> buffers) {
+    bool same = valid_;
+    for (size_t i = 0; i < Count; ++i) {
+      same &= infos_[i].buffer == buffers[i].buffer && infos_[i].range == buffers[i].range;
+      infos_[i] = {buffers[i].buffer, 0, buffers[i].range};
+    }
+    valid_ = true;
+    return same;
+  }
+  const VkDescriptorBufferInfo* data() const { return infos_.data(); }
+ private:
+  bool valid_ = false;
+  std::array<VkDescriptorBufferInfo, Count> infos_{};
+};
+}  // namespace rex::graphics::vulkan
