+void Presenter::FramePacingThread() {
+  uint64_t consumed = 0;
+  // Display refreshes (presents) the current guest frame has been queued for.
+  uint32_t shown_refreshes = 0;
+  // Whether frames are arriving; while idle, wait for the next one instead of
+  // presenting the same image every refresh.
+  bool streaming = false;
+#if REX_PLATFORM_PS5
+  auto next_request = std::chrono::steady_clock::now();
+#endif
+  for (;;) {
+    uint64_t published;
+    double interval_ms;
+    {
+      std::unique_lock<std::mutex> lock(frame_pacing_mutex_);
+      if (!streaming) {
+        frame_pacing_condition_.wait(lock, [&] {
+          return frame_pacing_shutdown_ || frame_pacing_published_ > consumed;
+        });
+      }
+      if (frame_pacing_shutdown_) {
+        return;
+      }
+      published = frame_pacing_published_;
+      interval_ms = frame_pacing_interval_ms_;
+    }
+    // 60 Hz display: guest frames at 30 FPS take two refreshes, at 60 FPS one.
+    const uint32_t refreshes_per_frame = interval_ms > 25.0 ? 2 : 1;
+    const bool new_frame = published > consumed;
+    const bool consume = new_frame && (!streaming || shown_refreshes >= refreshes_per_frame);
+    if (!consume && shown_refreshes >= refreshes_per_frame + 2) {
+      // The guest stopped producing frames (loading, pause): the display keeps
+      // the last image; wait for the next frame.
+      streaming = false;
+      continue;
+    }
+#if REX_PLATFORM_PS5
+    // VideoOut queues flips asynchronously. Do not stuff the FIFO with copies
+    // of the held image or count queued presents as completed display refreshes.
+    if (!consume) {
+      // Publication can arrive immediately after this check. Waiting for a
+      // vblank here needlessly defers it by a refresh; wake on publication.
+      std::unique_lock<std::mutex> lock(frame_pacing_mutex_);
+      frame_pacing_condition_.wait(lock, [&] {
+        return frame_pacing_shutdown_ || frame_pacing_published_ > consumed;
+      });
+      if (frame_pacing_shutdown_) return;
+      continue;
+    }
+    {
+      std::unique_lock<std::mutex> lock(frame_pacing_mutex_);
+      frame_pacing_condition_.wait_until(lock, next_request,
+                                        [&] { return frame_pacing_shutdown_; });
+      if (frame_pacing_shutdown_) return;
+      published = frame_pacing_published_;
+      if (published <= consumed) continue;
+    }
+    // Schedule from request time, not completion time: scanout latency must
+    // not be added to the frame period. The PS5 output runs at 59.94 Hz.
+    next_request = std::chrono::steady_clock::now() +
+        std::chrono::nanoseconds(uint64_t(refreshes_per_frame) * 16683350);
+    const uint64_t previous_flip = rex_ps5_display_flip_serial();
+#endif
+    PaintResult paint_result = PaintResult::kNotPresented;
+    bool painted = false;
+    [[maybe_unused]] bool ui_paint_requested = false;
+    {
+      std::lock_guard<std::mutex> paint_mode_mutex_lock(paint_mode_mutex_);
+      if (paint_mode_ == PaintMode::kGuestOutputThreadImmediately) {
+        if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedPaintable) {
+#if REX_PLATFORM_PS5
+          frame_pacing_consume_pending_.store(consume, std::memory_order_release);
+#endif
+          consume_hold_ = !consume;
+          paint_result = PaintAndPresent(false);
+          consume_hold_ = false;
+          painted = true;
+          if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
+            RequestPaintOrConnectionRecoveryViaWindow(true);
+          }
+        }
+      } else if (paint_mode_ == PaintMode::kUIThreadOnRequest && consume) {
+#if REX_PLATFORM_PS5
+        frame_pacing_consume_pending_.store(true, std::memory_order_release);
+        rex::diagnostic::Event(4, published, previous_flip);
+#endif
+        RequestPaintOrConnectionRecoveryViaWindow(true);
+        ui_paint_requested = true;
+      }
+    }
+    if (host_gpu_loss_callback_) {
+      if (paint_result == PaintResult::kGpuLostResponsible) {
+        host_gpu_loss_callback_(true, false);
+      } else if (paint_result == PaintResult::kGpuLostExternally) {
+        host_gpu_loss_callback_(false, false);
+      }
+    }
+    const bool presented = painted && (paint_result == PaintResult::kPresented ||
+                                       paint_result == PaintResult::kPresentedSuboptimal);
+#if REX_PLATFORM_PS5
+    streaming = (presented || ui_paint_requested) && rex_ps5_display_wait_for_flip(previous_flip);
+    static bool flip_verified = false;
+    if (streaming && !flip_verified) {
+      REXLOG_INFO("PS5 display-completion pacing: first flip confirmed on screen");
+      flip_verified = true;
+    }
+    if (streaming) {
+      rex::diagnostic::Event(6, frame_pacing_acquired_image_.load(std::memory_order_acquire),
+                               rex_ps5_display_flip_serial());
+      // The UI may acquire a newer ready image than the request snapshot.
+      // Acknowledge the image actually displayed, never the stale snapshot.
+      consumed = frame_pacing_acquired_image_.load(std::memory_order_acquire);
+      shown_refreshes = refreshes_per_frame;
+      static uint64_t last_image = 0;
+      static uint64_t completed_images = 0;
+      static uint64_t repeated_images = 0;
+      static auto report_start = std::chrono::steady_clock::now();
+      static auto last_completion = report_start;
+      static double max_gap_ms = 0;
+      const auto now = std::chrono::steady_clock::now();
+      const uint64_t image = frame_pacing_acquired_image_.load(std::memory_order_acquire);
+      if (image != last_image) {
+        if (last_image) {
+          max_gap_ms = std::max(max_gap_ms,
+              std::chrono::duration<double, std::milli>(now - last_completion).count());
+        }
+        last_completion = now;
+        ++completed_images;
+      } else {
+        ++repeated_images;
+      }
+      last_image = image;
+      const double seconds = std::chrono::duration<double>(now - report_start).count();
+      if (seconds >= 5.0) {
+        REXLOG_INFO("PS5 display cadence: seconds={:.2f} distinct_images={} repeated_images={} "
+                    "max_gap_ms={:.1f} guest_image={} submitted_flip={}",
+                    seconds, completed_images, repeated_images, max_gap_ms, image,
+                    rex_ps5_display_flip_serial());
+        report_start = now;
+        completed_images = repeated_images = 0;
+        max_gap_ms = 0;
+      }
+    } else {
+      // A failed paint/flip has not consumed a displayed frame. Avoid spinning
+      // on an unavailable surface, and recheck shutdown on the next iteration.
+      std::unique_lock<std::mutex> lock(frame_pacing_mutex_);
+      frame_pacing_condition_.wait_for(lock, std::chrono::milliseconds(16),
+                                      [&] { return frame_pacing_shutdown_; });
+    }
+#else
+    if (consume && presented) {
+      consumed = published;
+      shown_refreshes = 1;
+    } else if (presented) {
+      ++shown_refreshes;
+    }
+    // Without a present there is no display refresh to wait on.
+    streaming = presented;
+#endif
+  }
+}
