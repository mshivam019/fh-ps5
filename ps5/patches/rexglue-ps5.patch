+bool PhysicalHeap::IsSystemPageGuestWritable(uint32_t system_page) const {
+  if (page_table_.empty()) {
+    return false;
+  }
+  const uint32_t page_first =
+      rex::sat_sub(system_page * system_page_size_, host_address_offset()) >> page_size_shift_;
+  const uint32_t page_last = std::min(
+      rex::sat_sub(system_page * system_page_size_ + (system_page_size_ - 1),
+                   host_address_offset()) >>
+          page_size_shift_,
+      uint32_t(page_table_.size() - 1));
+  auto writable = [&](uint32_t page) {
+    const rex::memory::PageAccess access = ToPageAccess(page_table_[page].current_protect);
+    return access != rex::memory::PageAccess::kNoAccess &&
+           access != rex::memory::PageAccess::kReadOnly;
+  };
+  // Committed pages decide, like the host page access reconciliation; a host
+  // page with no committed guest pages keeps the first page's state.
+  bool any_committed = false;
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    if (!(page_table_[page].state & memory::kMemoryAllocationCommit)) {
+      continue;
+    }
+    any_committed = true;
+    if (writable(page)) {
+      return true;
+    }
+  }
+  return !any_committed && writable(page_first);
+}
