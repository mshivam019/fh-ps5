+// PS5 direct-memory backing for ReXGlue's sparse, aliased guest arena.
+// Uses the existing PS5 platform allocator; each backing unit is shared by
+// every guest alias and is allocated only at its first explicit commit.
+#include <rex/memory/utils.h>
+#include <ps5platform/kernel.h>
+#include <ps5platform/shm.h>
+#include <algorithm>
+#include <limits>
+#include <map>
+#include <set>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace rex::memory {
+namespace {
+constexpr size_t kPage = 0x4000;
+constexpr size_t kUnit = 0x10000;
+struct View {
+  uintptr_t base;
+  size_t size, offset;
+  std::vector<PageAccess> access;
+  std::set<size_t> mapped;
+};
+struct Mapping {
+  size_t size;
+  std::vector<View> views;
+  std::map<size_t, ps5_shm> units;
+};
+std::recursive_mutex arena_mutex;
+std::map<FileMappingHandle, std::unique_ptr<Mapping>> mappings;
+std::map<uintptr_t, size_t> private_ranges;
+size_t RoundUp(size_t value, size_t align) { return (value + align - 1) & ~(align - 1); }
+int Protection(PageAccess access) {
+  switch (access) {
+    case PageAccess::kNoAccess: return 0;
+    case PageAccess::kReadOnly: return PS5_SHM_READ;
+    case PageAccess::kReadWrite: return PS5_SHM_READ | PS5_SHM_WRITE;
+    case PageAccess::kExecuteReadOnly: return PS5_SHM_READ | PS5_SHM_EXEC;
+    case PageAccess::kExecuteReadWrite: return PS5_SHM_READ | PS5_SHM_WRITE | PS5_SHM_EXEC;
+  }
+  return 0;
+}
+bool Contains(uintptr_t base, size_t bytes, uintptr_t address, size_t length) {
+  return address >= base && address - base <= bytes && length <= bytes - (address - base);
+}
+bool FindView(uintptr_t address, size_t length, Mapping*& mapping, View*& view) {
+  for (auto& [handle, candidate] : mappings) {
+    for (auto& v : candidate->views) {
+      if (Contains(v.base, v.size, address, length)) {
+        mapping = candidate.get(); view = &v; return true;
+      }
+    }
+  }
+  return false;
+}
+bool MapUnit(View& view, size_t offset, const ps5_shm& unit) {
+  if (offset < view.offset || offset - view.offset >= view.size) return true;
+  const size_t relative = offset - view.offset;
+  void* desired = reinterpret_cast<void*>(view.base + relative);
+  void* actual = nullptr;
+  if (ps5_shm_map(&unit, 0, kUnit, desired, PS5_SHM_READ | PS5_SHM_WRITE,
+                  PS5_SHM_FIXED, &actual) != 0) return false;
+  if (actual != desired) return false;
+  view.mapped.insert(offset);
+  for (size_t page = 0; page < kUnit / kPage; ++page) {
+    auto access = view.access[relative / kPage + page];
+    if (access != PageAccess::kReadWrite &&
+        sceKernelMprotect(reinterpret_cast<void*>(view.base + relative + page * kPage),
+                          kPage, Protection(access)) != 0) return false;
+  }
+  return true;
+}
+bool EnsureBacking(Mapping& mapping, size_t offset, size_t length) {
+  const size_t begin = offset & ~(kUnit - 1);
+  const size_t end = RoundUp(offset + length, kUnit);
+  for (size_t unit_offset = begin; unit_offset < end; unit_offset += kUnit) {
+    if (mapping.units.contains(unit_offset)) continue;
+    ps5_shm unit{};
+    if (ps5_shm_create(kUnit, &unit) != 0) return false;
+    auto [entry, inserted] = mapping.units.emplace(unit_offset, unit);
+    for (auto& view : mapping.views) {
+      if (!MapUnit(view, unit_offset, entry->second)) {
+        for (auto& rollback : mapping.views) {
+          if (rollback.mapped.erase(unit_offset))
+            ps5_shm_unmap(reinterpret_cast<void*>(rollback.base + unit_offset - rollback.offset),
+                          kUnit, PS5_SHM_KEEP_RESERVED);
+        }
+        ps5_shm_destroy(&entry->second);
+        mapping.units.erase(entry);
+        return false;
+      }
+    }
+  }
+  return true;
+}
+bool SetViewAccess(Mapping& mapping, View& view, uintptr_t address, size_t length,
+                   PageAccess access, bool commit) {
+  const uintptr_t begin = address & ~(kPage - 1);
+  const uintptr_t end = RoundUp(address + length, kPage);
+  if (!Contains(view.base, view.size, begin, end - begin)) return false;
+  const size_t first_unit = (view.offset + begin - view.base) & ~(kUnit - 1);
+  const size_t last_unit = RoundUp(view.offset + end - view.base, kUnit);
+  std::vector<size_t> newly_backed;
+  if (commit) {
+    for (size_t offset = first_unit; offset < last_unit; offset += kUnit)
+      if (!mapping.units.contains(offset)) newly_backed.push_back(offset);
+  }
+  auto rollback_backing = [&] {
+    for (size_t offset : newly_backed) {
+      auto found = mapping.units.find(offset);
+      if (found == mapping.units.end()) continue;
+      for (auto& alias : mapping.views) {
+        if (alias.mapped.erase(offset))
+          ps5_shm_unmap(reinterpret_cast<void*>(alias.base + offset - alias.offset),
+                        kUnit, PS5_SHM_KEEP_RESERVED);
+      }
+      ps5_shm_destroy(&found->second);
+      mapping.units.erase(found);
+    }
+  };
+  if (commit && !EnsureBacking(mapping, view.offset + begin - view.base, end - begin)) {
+    rollback_backing(); return false;
+  }
+  // Write watches protect and unprotect long page runs on every upload, so skip
+  // pages already at the requested access and change each run of consecutive
+  // backed pages with a single call.
+  std::vector<std::pair<size_t, PageAccess>> changed;  // page index, previous access
+  uintptr_t run_begin = 0;
+  size_t run_pages = 0;
+  auto flush_run = [&] {
+    if (!run_pages) return true;
+    const bool ok = sceKernelMprotect(reinterpret_cast<void*>(run_begin), run_pages * kPage,
+                                      Protection(access)) == 0;
+    run_pages = 0;
+    return ok;
+  };
+  auto fail = [&] {
+    for (auto it = changed.rbegin(); it != changed.rend(); ++it) {
+      const uintptr_t old_page = view.base + it->first * kPage;
+      const size_t old_offset = view.offset + it->first * kPage;
+      if (mapping.units.contains(old_offset & ~(kUnit - 1)))
+        if (sceKernelMprotect(reinterpret_cast<void*>(old_page), kPage,
+                              Protection(it->second)) != 0) std::abort();
+      view.access[it->first] = it->second;
+    }
+    rollback_backing();
+    return false;
+  };
+  size_t cached_unit = SIZE_MAX;
+  bool cached_unit_backed = false;
+  for (uintptr_t page = begin; page < end; page += kPage) {
+    const size_t index = (page - view.base) / kPage;
+    const size_t unit = (view.offset + page - view.base) & ~(kUnit - 1);
+    if (unit != cached_unit) {
+      cached_unit = unit;
+      cached_unit_backed = mapping.units.contains(unit);
+    }
+    const PageAccess old_access = view.access[index];
+    if (old_access == access) {
+      if (!flush_run()) return fail();
+      continue;
+    }
+    changed.emplace_back(index, old_access);
+    view.access[index] = access;
+    if (!cached_unit_backed) {
+      if (!flush_run()) return fail();
+      continue;
+    }
+    if (run_pages && run_begin + run_pages * kPage == page) {
+      ++run_pages;
+    } else {
+      if (!flush_run()) return fail();
+      run_begin = page;
+      run_pages = 1;
+    }
+  }
+  if (!flush_run()) return fail();
+  return true;
+}
+}  // namespace
+
+size_t page_size() { return kPage; }
+size_t allocation_granularity() { return kUnit; }
+bool IsWritableExecutableMemorySupported() { return true; }
+
+void* AllocFixed(void* address, size_t length, AllocationType type, PageAccess access) {
+  if (!length || length > std::numeric_limits<size_t>::max() - kUnit) return nullptr;
+  std::lock_guard lock(arena_mutex);
+  const uintptr_t start = reinterpret_cast<uintptr_t>(address);
+  Mapping* mapping = nullptr; View* view = nullptr;
+  if (address && FindView(start, length, mapping, view)) {
+    if (type == AllocationType::kReserve) return address;
+    return SetViewAccess(*mapping, *view, start, length, access, true) ? address : nullptr;
+  }
+  for (auto [base, bytes] : private_ranges) {
+    if (address && Contains(base, bytes, start, length)) {
+      if (type == AllocationType::kReserve) return address;
+      return ps5_vrange_commit(address, length, Protection(access)) == 0 ? address : nullptr;
+    }
+  }
+  void* base = address;
+  const size_t bytes = RoundUp(length, kUnit);
+  int result = address ? ps5_vrange_reserve_at(address, bytes)
+                       : ps5_vrange_reserve(bytes, nullptr, kUnit, &base);
+  if (result) return nullptr;
+  if (type != AllocationType::kReserve && ps5_vrange_commit(base, length, Protection(access))) {
+    ps5_vrange_release(base, bytes); return nullptr;
+  }
+  private_ranges.emplace(reinterpret_cast<uintptr_t>(base), bytes);
+  return base;
+}
+
+bool DeallocFixed(void* address, size_t length, DeallocationType type) {
+  std::lock_guard lock(arena_mutex);
+  const auto start = reinterpret_cast<uintptr_t>(address);
+  Mapping* mapping = nullptr; View* view = nullptr;
+  if (FindView(start, length ? length : 1, mapping, view)) {
+    // Guest heap disposal must not release an alias owned by the arena. Shared
+    // backing remains owned until UnmapFileView / CloseFileMappingHandle.
+    if (type == DeallocationType::kRelease && !length) return true;
+    return SetViewAccess(*mapping, *view, start, length, PageAccess::kNoAccess, false);
+  }
+  auto found = private_ranges.find(start);
+  if (type == DeallocationType::kRelease) {
+    if (found == private_ranges.end()) return false;
+    if (ps5_vrange_release(address, found->second)) return false;
+    private_ranges.erase(found); return true;
+  }
+  return length && ps5_vrange_decommit(address, length) == 0;
+}
+
+bool QueryProtect(void* address, size_t& length, PageAccess& access) {
+  void* begin = nullptr; void* end = nullptr; uint32_t protection = 0;
+  length = 0; access = PageAccess::kNoAccess;
+  if (sceKernelQueryMemoryProtection(address, &begin, &end, &protection) != 0) return false;
+  if (reinterpret_cast<uintptr_t>(end) <= reinterpret_cast<uintptr_t>(address)) return false;
+  length = reinterpret_cast<uintptr_t>(end) - reinterpret_cast<uintptr_t>(address);
+  if (protection & PS5_SHM_EXEC)
+    access = protection & PS5_SHM_WRITE ? PageAccess::kExecuteReadWrite : PageAccess::kExecuteReadOnly;
+  else if (protection & PS5_SHM_WRITE) access = PageAccess::kReadWrite;
+  else if (protection & PS5_SHM_READ) access = PageAccess::kReadOnly;
+  return true;
+}
+
+bool Protect(void* address, size_t length, PageAccess access, PageAccess* previous) {
+  if (!length) return false;
+  if (previous) { size_t old_length; if (!QueryProtect(address, old_length, *previous)) return false; }
+  std::lock_guard lock(arena_mutex);
+  const auto start = reinterpret_cast<uintptr_t>(address);
+  Mapping* mapping = nullptr; View* view = nullptr;
+  if (FindView(start, length, mapping, view))
+    return SetViewAccess(*mapping, *view, start, length, access, access != PageAccess::kNoAccess);
+  const auto begin = start & ~(kPage - 1);
+  return sceKernelMprotect(reinterpret_cast<void*>(begin), RoundUp(start + length, kPage) - begin,
+                           Protection(access)) == 0;
+}
+
+FileMappingHandle CreateFileMappingHandle(const std::filesystem::path&, size_t length,
+                                          PageAccess, bool) {
+  if (!length || length > std::numeric_limits<size_t>::max() - kUnit) return kFileMappingHandleInvalid;
+  std::lock_guard lock(arena_mutex);
+  auto mapping = std::make_unique<Mapping>(); mapping->size = RoundUp(length, kUnit);
+  const auto handle = reinterpret_cast<FileMappingHandle>(mapping.get());
+  mappings.emplace(handle, std::move(mapping)); return handle;
+}
+
+void* MapFileView(FileMappingHandle handle, void* address, size_t length, PageAccess access,
+                  size_t offset) {
+  std::lock_guard lock(arena_mutex);
+  auto found = mappings.find(handle);
+  if (found == mappings.end() || !length || offset % kUnit || length % kUnit ||
+      offset > found->second->size || length > found->second->size - offset) return nullptr;
+  void* base = address;
+  int result = address ? ps5_vrange_reserve_at(address, length)
+                       : ps5_vrange_reserve(length, nullptr, kUnit, &base);
+  if (result) return nullptr;
+  View view{reinterpret_cast<uintptr_t>(base), length, offset,
+            std::vector<PageAccess>(length / kPage, access), {}};
+  for (const auto& [unit_offset, unit] : found->second->units) {
+    if (!MapUnit(view, unit_offset, unit)) {
+      for (size_t mapped : view.mapped)
+        ps5_shm_unmap(reinterpret_cast<void*>(view.base + mapped - view.offset), kUnit,
+                      PS5_SHM_KEEP_RESERVED);
+      ps5_vrange_release(base, length); return nullptr;
+    }
+  }
+  found->second->views.push_back(std::move(view)); return base;
+}
+
+bool UnmapFileView(FileMappingHandle handle, void* address, size_t length) {
+  std::lock_guard lock(arena_mutex);
+  auto found = mappings.find(handle); if (found == mappings.end()) return false;
+  auto& mapping = *found->second;
+  auto it = std::find_if(mapping.views.begin(), mapping.views.end(), [&](const View& view) {
+    return view.base == reinterpret_cast<uintptr_t>(address) && view.size == length;
+  });
+  if (it == mapping.views.end()) return false;
+  for (const auto& [offset, unit] : mapping.units) {
+    if (it->mapped.contains(offset))
+      if (ps5_shm_unmap(reinterpret_cast<void*>(it->base + offset - it->offset), kUnit,
+                        PS5_SHM_KEEP_RESERVED) != 0) return false;
+  }
+  if (ps5_vrange_release(address, length)) return false;
+  mapping.views.erase(it); return true;
+}
+void CloseFileMappingHandle(FileMappingHandle handle, const std::filesystem::path&) {
+  std::lock_guard lock(arena_mutex);
+  auto found = mappings.find(handle); if (found == mappings.end()) return;
+  while (!found->second->views.empty()) {
+    const auto view = found->second->views.back();
+    if (!UnmapFileView(handle, reinterpret_cast<void*>(view.base), view.size)) return;
+  }
+  for (auto& [offset, unit] : found->second->units) ps5_shm_destroy(&unit);
+  mappings.erase(found);
+}
