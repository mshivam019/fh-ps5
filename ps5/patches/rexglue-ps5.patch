+void Presenter::ShutdownFramePacing() {
+  if (!frame_pacing_thread_.joinable()) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(frame_pacing_mutex_);
+    frame_pacing_shutdown_ = true;
+  }
+  frame_pacing_condition_.notify_all();
+  frame_pacing_thread_.join();
+}
