diff --git a/include/rex/diagnostic_trace.h b/include/rex/diagnostic_trace.h
new file mode 100644
index 0000000..1548471
--- /dev/null
+++ b/include/rex/diagnostic_trace.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <rex/platform.h>
+#include <cstdint>
+#include <chrono>
+#if REX_PLATFORM_PS5
+extern "C" bool rex_ps5_trace_enabled();
+extern "C" void rex_ps5_trace(uint32_t stage, uint64_t id, uint64_t argument,
+                               uint64_t duration_ns, const char* path);
+namespace rex::diagnostic {
+inline uint64_t Now() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+inline void Event(uint32_t stage, uint64_t id = 0, uint64_t argument = 0) {
+  if (rex_ps5_trace_enabled()) rex_ps5_trace(stage, id, argument, 0, nullptr);
+}
+class SlowScope {
+ public:
+  SlowScope(uint32_t stage, uint64_t id = 0, uint64_t argument = 0,
+            const char* path = nullptr, bool active = true)
+      : stage_(stage), id_(id), argument_(argument), path_(path),
+        begin_(active && rex_ps5_trace_enabled() ? Now() : 0) {}
+  ~SlowScope() {
+    if (!begin_) return;
+    const uint64_t duration = Now() - begin_;
+    if (duration >= 2000000) rex_ps5_trace(stage_, id_, argument_, duration, path_);
+  }
+ private:
+  uint32_t stage_;
+  uint64_t id_, argument_;
+  const char* path_;
+  uint64_t begin_;
+};
+}
+#endif
diff --git a/include/rex/filesystem/case_path.h b/include/rex/filesystem/case_path.h
new file mode 100644
index 0000000..1624b1b
--- /dev/null
+++ b/include/rex/filesystem/case_path.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <filesystem>
+#include <string_view>
+#include <system_error>
+
+namespace rex::filesystem {
+// Content names use Xbox's ASCII case-insensitive lookup. Preserve the stored
+// spelling so opening, overwriting and deleting all address the same package.
+inline std::filesystem::path ResolveCaseInsensitiveLeaf(const std::filesystem::path& path) {
+  std::error_code ec;
+  if (std::filesystem::exists(path, ec)) return path;
+  const auto wanted = path.filename().string();
+  auto equal = [](std::string_view a, std::string_view b) {
+    if (a.size() != b.size()) return false;
+    auto lower = [](unsigned char c) { return c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c; };
+    for (size_t i = 0; i < a.size(); ++i)
+      if (lower(a[i]) != lower(b[i])) return false;
+    return true;
+  };
+  std::filesystem::directory_iterator it(path.parent_path(), ec), end;
+  while (!ec && it != end) {
+    if (equal(it->path().filename().string(), wanted)) return it->path();
+    it.increment(ec);
+  }
+  // Missing paths retain their requested spelling for creation/error reporting.
+  return path;
+}
+}  // namespace rex::filesystem
